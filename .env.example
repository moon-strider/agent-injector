# Explicitly export settings or configure them in the parent MCP client.
# The server does not automatically search for or load .env files.
LLM_BASE_URL=http://127.0.0.1:8080
LLM_MODEL=qwen3-1.7b
# LLM_API_KEY is optional only for explicit loopback endpoints.
# LLM_API_KEY=local
DEFAULT_PROVIDER=custom
AGENT_WORKING_ROOT=/absolute/path/to/workspace
AGENT_ALLOWED_TOOLS=Read,Glob,Grep,Bash,Edit,Write
AGENT_MAX_CONCURRENT=4
AGENT_MAX_QUEUED=32
AGENT_MAX_RETAINED=128
AGENT_RETENTION_SECONDS=900
AGENT_MAX_TIMEOUT_SECONDS=1200
AGENT_MAX_TURNS=100
AGENT_MAX_OUTPUT_BYTES=1048576
AGENT_OUTPUT_TOKENS=4096
# CLAUDE_BIN=/absolute/path/to/claude
# AGENT_SYSTEM_PROMPT=You are a concise assistant. Use the available tools.
# MINIMAX_API_KEY=...
# ZAI_API_KEY=...
